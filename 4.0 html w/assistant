        <div id="homeQuickPanel" aria-hidden="true">
            <div class="hqp-head"><div><span class="hqp-kicker">HOME CONTROLS</span><b>Quick Settings</b></div><button class="hqp-close" onclick="hideHomeQuickPanel(true)">×</button></div>
            <div class="hqp-grid">
                <button class="hqp-card" onclick="openHomeQuick('wallpaper')"><span class="hqp-icon"></span><span><b>Wallpaper</b><small>Backgrounds and motion</small></span><i>›</i></button>
                <button class="hqp-card" onclick="openHomeQuick('settings')"><span class="hqp-icon"></span><span><b>Settings</b><small>System and personalization</small></span><i>›</i></button>
                <button class="hqp-card" onclick="openHomeQuick('design')"><span class="hqp-icon"></span><span><b>Home Design</b><small>Layout and home style</small></span><i>›</i></button>
                <button class="hqp-card" onclick="openHomeQuick('sound')"><span class="hqp-icon"></span><span><b>Sound</b><small>Interface volume</small></span><i>›</i></button>
            </div>
            <button class="hqp-card mod1-card" onclick="mod1AutoAlign()"><span class="hqp-icon"></span><span><b>Auto Align</b><small>Arrange Home apps</small></span><i>›</i></button><div class="hqp-footer"><span>MOD1</span><button onclick="openMod1Settings()">MOD1 Settings</button></div>
        </div>

        <div id="startMenu">
            <div class="start-head"><input id="appSearch" class="search" placeholder="Search apps..." oninput="filterApps()"></div>
            <div class="start-title">Applications</div>
            <div class="apps-grid" id="appGrid"></div>
            <div class="start-footer"><button class="toolbtn" onclick="openApp('settings');toggleStart()">⚙ Settings</button><button class="toolbtn" onclick="powerMenu()">⏻ Power</button></div>
        </div>
