function addWidget(type){
  if(!state.widgets) state.widgets=[];
  const id='w_'+Date.now();
  const n=state.widgets.length;
  state.widgets.push({id,type,x:30+(n%3)*240,y:130+Math.floor(n/3)*150});
  save(); closeModal(); renderWidgets(); notify('Widgets', type.charAt(0).toUpperCase()+type.slice(1)+' widget added');
}
async function removeWidget(id){
  state.widgets=(state.widgets||[]).filter(w=>w.id!==id);
  await deleteWidgetImage(id);
  save(); renderWidgets();
}
function widgetMarkup(w){
  if(w.type==='clock') return `<h4>🕐 Clock</h4><div class="widget-value" id="wv_${w.id}">--:--</div><div class="widget-small" id="wd_${w.id}">--</div>`;
  if(w.type==='battery') return `<h4>🔋 Battery</h4><div class="widget-value" id="wb_${w.id}">⌁ —</div><div class="widget-small" id="wbs_${w.id}">Battery status</div>`;
  if(w.type==='notes') return `<h4>📝 Quick Notes</h4><textarea style="width:100%;height:62px;resize:none;background:#0003;color:#fff;border:1px solid #fff2;border-radius:10px;padding:8px" placeholder="Type something..." oninput="updateWidgetNote('${w.id}',this.value)">${esc(w.text||'')}</textarea>`;
  if(w.type==='images') return `<h4>🖼️ Images</h4><label style="display:block;padding:10px;border:1px dashed #fff3;border-radius:10px;text-align:center;cursor:pointer;color:var(--muted)">＋ Choose Image<input type="file" accept="image/*" hidden onchange="updateWidgetImage('${w.id}',this.files[0])"></label>${(w.imageKey||w.image)?`<div class="widget-image-slot" data-widget-image="${w.id}" style="height:150px;display:grid;place-items:center;color:var(--muted);font-size:12px;margin-top:9px">Loading image…</div>`:`<div style="height:95px;display:grid;place-items:center;color:var(--muted);font-size:12px">No image selected</div>`}`;
  return `<h4>💻 System</h4><div class="widget-value">LUMA</div><div class="widget-small">v3.23 · ${Object.keys(apps).length} apps</div>`;
}
function updateWidgetNote(id,text){const w=(state.widgets||[]).find(x=>x.id===id);if(w){w.text=text;save()}}
async function updateWidgetImage(id,file){
  const w=(state.widgets||[]).find(x=>x.id===id); if(!w||!file)return;
  const ok=await saveWidgetImage(id,file);
  if(!ok){notify('Widgets','Could not save that image');return;}
  delete w.image;
  w.imageKey=id;
  save();
  renderWidgets();
  notify('Widgets','Image added');
}
async function hydrateWidgetImages(){
  document.querySelectorAll('.widget-image-slot[data-widget-image]').forEach(async slot=>{
    const id=slot.dataset.widgetImage;
    const w=(state.widgets||[]).find(x=>x.id===id);
    let blob=null;
    if(w?.imageKey) blob=await loadWidgetImage(w.imageKey);
    // Migrate older 3.22 images that were stored directly in localStorage.
    if(!blob && w?.image){
      try{
        const res=await fetch(w.image);
        blob=await res.blob();
        if(await saveWidgetImage(id,blob)){ delete w.image; w.imageKey=id; save(); }
      }catch(e){}
    }
    if(blob){
      const url=URL.createObjectURL(blob);
      slot.innerHTML=`<img src="${url}" alt="Widget image" style="display:block;width:100%;height:150px;object-fit:cover;border-radius:10px">`;
      slot.dataset.objectUrl=url;
    }else{
      slot.textContent='Image unavailable';
    }
  });
}
function renderWidgets(){
  const root=$('widgetLayer'); if(!root)return; const list=state.widgets||[];
  root.innerHTML=list.map(w=>`<div class="luma-widget" data-widget="${w.id}" style="left:${w.x}px;top:${w.y}px"><button class="widget-x" onclick="removeWidget('${w.id}')">×</button>${widgetMarkup(w)}</div>`).join('');
  root.querySelectorAll('.luma-widget').forEach(el=>{let drag=false,sx=0,sy=0,ox=0,oy=0;el.addEventListener('pointerdown',e=>{if(e.target.closest('button,textarea,input,label'))return;drag=true;sx=e.clientX;sy=e.clientY;const w=state.widgets.find(x=>x.id===el.dataset.widget);ox=w.x;oy=w.y;el.setPointerCapture(e.pointerId)});el.addEventListener('pointermove',e=>{if(!drag)return;const w=state.widgets.find(x=>x.id===el.dataset.widget);w.x=Math.max(8,ox+e.clientX-sx);w.y=Math.max(70,oy+e.clientY-sy);el.style.left=w.x+'px';el.style.top=w.y+'px'});el.addEventListener('pointerup',()=>{if(drag){drag=false;save()}})});
  updateWidgets();
  hydrateWidgetImages();
}
function updateWidgets(){
  const now=new Date(); document.querySelectorAll('[id^="wv_"]').forEach(e=>e.textContent=now.toLocaleTimeString([], {hour:'numeric',minute:'2-digit'}));
  document.querySelectorAll('[id^="wd_"]').forEach(e=>e.textContent=now.toLocaleDateString([], {weekday:'long',month:'short',day:'numeric'}));
  if(batteryManager){const level=Math.round((batteryManager.level||0)*100), charging=!!batteryManager.charging;document.querySelectorAll('[id^="wb_"]').forEach(e=>e.textContent=(charging?'⚡ ':'')+level+'%');document.querySelectorAll('[id^="wbs_"]').forEach(e=>e.textContent=charging?'Charging':'On battery');}
}
setInterval(updateWidgets,1000);
function renderDesktopIcons(){
    const root=$("desktopIcons");if(!root)return;
    const base=[['files'],['browser'],['notes'],['settings'],['store'],['wallpaper'],['extensions'],['themestudio'],['trash'],...state.installedApps.map(a=>[a.id])];
    const defs=base.filter(([id])=>!(state.homeHidden||[]).includes(id)).map(x=>[x[0],minimalIcon(x[0],apps[x[0]]?.icon||'□'),apps[x[0]]?.name||x[0]]);
    root.innerHTML=defs.map(([id,icon,name],i)=>{const p=state.homeIcons[id]||{x:15+(Math.floor(i/6)*100),y:55+(i%6)*92};state.homeIcons[id]=p;return `<div class="deskIcon grid-item" data-id="${esc(id)}" style="left:${p.x}px;top:${p.y}px" ondblclick="openApp('${esc(id)}')" onmouseenter="homeHoverId='${esc(id)}'" onmouseleave="if(homeHoverId==='${esc(id)}')homeHoverId=null"><span class="ico minimal-icon">${esc(icon)}</span>${esc(name)}</div>`}).join('');
    root.querySelectorAll('.grid-item').forEach(el=>{let drag=false,sx=0,sy=0,ox=0,oy=0;el.addEventListener('pointerdown',e=>{drag=true;el.setPointerCapture(e.pointerId);const p=state.homeIcons[el.dataset.id];sx=e.clientX;sy=e.clientY;ox=p.x;oy=p.y;el.classList.add('dragging')});el.addEventListener('pointermove',e=>{if(!drag)return;const p=state.homeIcons[el.dataset.id];p.x=Math.max(5,ox+e.clientX-sx);p.y=Math.max(40,oy+e.clientY-sy);el.style.left=p.x+'px';el.style.top=p.y+'px'});el.addEventListener('pointerup',()=>{if(!drag)return;drag=false;el.classList.remove('dragging');const p=state.homeIcons[el.dataset.id],cell=92;p.x=Math.round(p.x/cell)*cell+15;p.y=Math.round((p.y-40)/cell)*cell+40;p.x=Math.min(Math.max(5,p.x),innerWidth-95);p.y=Math.min(Math.max(40,p.y),innerHeight-115);el.style.left=p.x+'px';el.style.top=p.y+'px';el.classList.add('snapping');setTimeout(()=>el.classList.remove('snapping'),300);save()})});
}
function hideHomeApp(id){if(!id)return;state.homeHidden=Array.isArray(state.homeHidden)?state.homeHidden:[];if(!state.homeHidden.includes(id)){state.homeHidden.push(id);save();renderDesktopIcons();notify('Home Screen',`${apps[id]?.name||id} was removed from the Home Screen. It is still available in Applications.`);}homeHoverId=null;}

