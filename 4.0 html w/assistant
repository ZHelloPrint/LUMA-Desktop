        function termCommand(v) {
            let out = $("termOut");
            out.textContent += `luma@web:~$ ${v}\n`;
            let p = v.trim().split(/\s+/),
                cmd = p[0].toLowerCase(),
                arg = p.slice(1).join(" ");
            let r = "";
            switch (cmd) {
                case "help":
                    r = "help clear date time about apps open echo history whoami pwd ls mkdir touch delete shutdown restart";
                    break;
                case "clear":
                    out.textContent = "";
                    return;
                case "date":
                    r = new Date().toLocaleDateString();
                    break;
                case "time":
                    r = new Date().toLocaleTimeString();
                    break;
                case "about":
                    r = "LUMA — a browser-based operating system emulator.";
                    break;
                case "apps":
                    r = Object.values(apps).map(a => a.name).join("\n");
                    break;
                case "open":
                    let id = Object.keys(apps).find(k => apps[k].name.toLowerCase().includes(arg.toLowerCase()));
                    if (id) {
                        openApp(id);
                        r = "Opened " + apps[id].name
                    } else r = "App not found.";
                    break;
                case "echo":
                    r = arg;
                    break;
                case "history":
                    r = state.history.map((x, i) => (i + 1) + ". " + x.q).join("\n") || "No browser history.";
                    break;
                case "whoami":
                    r = "LUMA User";
                    break;
                case "pwd":
                    r = "/LUMA/" + (currentFolder ? (state.files.find(f => f.id === currentFolder)?.name || "") : "");
                    break;
                case "ls":
                    r = rootFiles().map(f => f.type === "folder" ? f.name + "/" : f.name).join("\n") || "(empty)";
                    break;
                case "mkdir":
                    state.files.push({
                        id: Date.now(),
                        name: arg || "New Folder",
                        type: "folder",
                        parent: currentFolder
                    });
                    save();
                    r = "Directory created.";
                    break;
                case "touch":
                    state.files.push({
                        id: Date.now(),
                        name: arg || "new.txt",
                        type: "text",
                        parent: currentFolder,
                        body: ""
                    });
                    save();
                    r = "File created.";
                    break;
                case "delete":
                    let f = state.files.find(x => x.name === arg && x.parent === currentFolder);
                    if (f) {
                        deleteFile(f.id);
                        r = "Deleted."
                    } else r = "File not found.";
                    break;
                case "shutdown":
                    showPower("shutdown");
                    return;
                case "restart":
                    showPower("restart");
                    return;
