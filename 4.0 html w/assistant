        function moveAppToTrash(id){
            const app = state.installedApps.find(a=>a.id===id);
            if(!app) return;
            state.trash.appData = Array.isArray(state.trash.appData) ? state.trash.appData : [];
            if(!state.trash.apps.some(x=>x===id)) state.trash.apps.push(id);
            if(!state.trash.appData.some(a=>a.id===id)) state.trash.appData.push(JSON.parse(JSON.stringify(app)));
            state.installedApps = state.installedApps.filter(a=>a.id!==id);
            delete apps[id];
            state.dockHidden = (state.dockHidden||[]).filter(x=>x!==id);
            state.trash.dock = (state.trash.dock||[]).filter(x=>x!==id);
            delete state.homeIcons[id];
            if(windows[id]) closeApp(id);
            save(); renderApps(); renderDesktopIcons(); renderDock(); refreshTrash(); notify('Trash', app.name+' was moved to Trash');
        }
        function restoreTrashApp(id){
            const entry = state.trash.apps.find(x=>x===id); if(!entry) return;
            const stored = state.installedApps.find(a=>a.id===id);
            // Keep a backup copy in trash metadata so restoration can happen after deletion.
            const backup = state.trash.appData?.find(a=>a.id===id);
            if(!backup) return notify('Trash','This app has no recoverable data.');
            state.installedApps.push(backup);
            apps[id] = {...backup, storeApp:true};
            state.trash.apps = state.trash.apps.filter(x=>x!==id);
            if(state.trash.appData) state.trash.appData = state.trash.appData.filter(a=>a.id!==id);
            save(); renderApps(); renderDesktopIcons(); renderDock(); refreshTrash(); notify('Trash', backup.name+' was restored');
        }
