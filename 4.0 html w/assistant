            setupPaint()
        }

        function setupPaint() {
            let c = $("paintCanvas"),
                x = c.getContext("2d");
            x.fillStyle = "#fff";
            x.fillRect(0, 0, c.width, c.height);
            paintHistory = [c.toDataURL()];
            paintStep = 0;
            let down = false;

            function pos(e) {
                let r = c.getBoundingClientRect();
                return {
                    x: (e.clientX - r.left) * c.width / r.width,
                    y: (e.clientY - r.top) * c.height / r.height
                }
            }
            c.onpointerdown = e => {
                down = true;
                let p = pos(e);
                x.beginPath();
                x.moveTo(p.x, p.y)
            };
            c.onpointermove = e => {
                if (!down) return;
                let p = pos(e);
                x.lineTo(p.x, p.y);
                x.strokeStyle = $("paintColor").value;
                x.lineWidth = $("paintSize").value;
                x.lineCap = "round";
                x.stroke()
            };
            c.onpointerup = () => {
                if (down) {
                    down = false;
                    paintHistory = paintHistory.slice(0, paintStep + 1);
                    paintHistory.push(c.toDataURL());
                    paintStep++
                }
            }
        }

        function paintUndo() {
            if (paintStep <= 0) return;
            paintStep--;
            restorePaint(paintHistory[paintStep])
