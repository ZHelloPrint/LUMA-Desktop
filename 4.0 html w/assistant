            border-radius: 8px;
            padding: 7px 10px
        }

        .toolbtn:hover {
            background: rgba(255, 255, 255, .15)
        }

        .browser {
            height: 100%;
            display: flex;
            flex-direction: column
        }

        .tabs {
            display: flex;
