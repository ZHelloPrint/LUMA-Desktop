        async function importWallpaper(e) {
            const file=e.target.files?.[0]; if(!file) return;
            try{
                const reader=new FileReader();
                reader.onload=async()=>{
                    const data=String(reader.result);
                    const isAnimated=/\.gif$/i.test(file.name)||file.type==='image/gif';
                    const useDB=isAnimated || file.size>1200000;
                    if(useDB){
                        const ok=await saveWallpaperBlob(data);
                        if(!ok){ notify("Wallpaper Engine","Could not store this wallpaper"); return; }
                        state.wallpaper=""; state.wallpaperMode="idb";
                    }else{
                        await clearWallpaperBlob();
                        state.wallpaper=data; state.wallpaperMode="image";
                    }
                    state.wallpaperFileName=file.name;
                    state.wallpaperMime=file.type||"image/*";
                    try{
                        state.files.push({id:Date.now(),name:file.name,type:"image",parent:state.files.find(x=>x.name==="Pictures"&&x.parent===null)?.id||null,data:useDB?null:data});
                    }catch(err){}
                    await applyTheme();
                    if(windows.files) drawFiles();
                    notify("Wallpaper Engine",isAnimated?"Animated wallpaper applied":"Wallpaper applied");
                };
                reader.onerror=()=>notify("Wallpaper Engine","Could not read that wallpaper");
                reader.readAsDataURL(file);
            }catch(err){ notify("Wallpaper Engine","That wallpaper could not be imported"); }
            e.target.value="";
        }

