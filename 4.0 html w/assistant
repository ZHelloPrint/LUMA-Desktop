            state.homeModule = {builtIn:"glass-dashboard", name:"Glass Workspace"};
            state.homeStyle = "glass-dashboard";
            try { save(); } catch (_) {}
        }

        function safeBoot() {
            try {
                renderApps();
                renderDesktopIcons();
                renderWidgets();
                renderDock();
                renderNotifications();
                applyTheme();
            } catch (err) {
                console.error("LUMA startup error:", err)
            }
            const boot = document.getElementById("boot");
            // Give LUMA a little extra time to render wallpapers, apps, widgets,
            // and the home-screen grid before revealing the desktop chrome.
            setTimeout(() => {
                const desktop = document.getElementById("desktop");
                desktop.classList.remove("preparing");
                boot.classList.add("ready");
                setTimeout(() => {
                    boot.style.display = "none";
