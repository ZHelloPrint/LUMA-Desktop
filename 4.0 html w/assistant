            <div id="modalBody"></div>
            <div class="modal-actions"><button class="toolbtn" onclick="closeModal()">Cancel</button><button class="toolbtn" id="modalOK">OK</button></div>
        </div>
    </div>

    <input id="wallpaperPicker" type="file" accept="image/*,.gif,.webp,.avif" hidden onchange="importWallpaper(event)">
    <input id="webpagePicker" type="file" accept=".html,.htm,text/html" hidden onchange="importWebpage(event)">
    <input id="storeAppPicker" type="file" accept=".html,.htm,text/html" hidden onchange="importStoreApp(event)">
    <script>
        const $ = id => document.getElementById(id);
        const apps = {
            browser: {
                name: "LUMA Browser",
                icon: "🌐",
                w: 900,
                h: 620
            },
            files: {
                name: "File Manager",
                icon: "📁",
                w: 760,
                h: 520
            },
            calc: {
                name: "Calculator",
                icon: "🧮",
                w: 360,
                h: 560
            },
            notes: {
                name: "Notes",
                icon: "📝",
                w: 700,
                h: 520
            },
            paint: {
                name: "Paint",
                icon: "🎨",
                w: 760,
                h: 560
            },
            terminal: {
                name: "Terminal",
                icon: "⌘",
                w: 680,
                h: 450
            },
            settings: {
                name: "Settings",
                icon: "⚙️",
                w: 760,
                h: 560
            },
            clockapp: {
                name: "Clock",
                icon: "🕐",
                w: 360,
                h: 300
            },
            about: {
                name: "About LUMA",
                icon: "●",
                w: 430,
                h: 330
            },
            wallpaper: { name:"Wallpaper Engine", icon:"🖼️", w:760, h:560 },
            extensions: { name:"Extensions", icon:"🧩", w:650, h:520 },
            themestudio: { name:"Home Design", icon:"✨", w:650, h:520 },
            store: { name:"LUMA Store", icon:"🛍️", w:820, h:600 },
            trash: { name:"Trash", icon:"🗑️", w:760, h:560 },
            taskmanager: { name:"Task Manager", icon:"◫", w:820, h:590, renderer:"taskmanager" },
            appcustomizer: { name:"App Customizer", icon:"🎨", w:720, h:560, renderer:"appcustomizer" },
            luma_ai: { name:"LUMA AI", icon:"✦", w:820, h:600, renderer:"luma_ai" }
        };
        let state = JSON.parse(localStorage.getItem("luma_state") || "null") || {
            theme: "dark",
            accent: "#4da3ff",
            wallpaper: "",
            wallpaperMode: "image",
            wallpaperClass: "",
            wallpaperFit: "cover",
            homeModule: null,
            homeStyle: "glass-dashboard",
            retroAero: false,
            homeIcons: {},
            homeHidden: [],
            widgets: [],
            webModules: [],
            extensions: { dark:false, reader:false, focus:false },
            installedApps: [],
            dockHidden: [],
            trash: { dock: [], apps: [], appData: [] },
            appCustom: {},
            notes: [{
                id: 1,
                title: "Welcome",
                body: "Welcome to LUMA Notes."
            }],
            files: [{
                    id: 1,
                    name: "Desktop",
                    type: "folder",
                    parent: null
                }, {
                    id: 2,
                    name: "Documents",
                    type: "folder",
                    parent: null
                },
                {
                    id: 3,
                    name: "Downloads",
                    type: "folder",
                    parent: null
                }, {
                    id: 4,
                    name: "Pictures",
                    type: "folder",
                    parent: null
                },
                {
                    id: 5,
                    name: "Music",
                    type: "folder",
                    parent: null
                }, {
                    id: 6,
                    name: "Videos",
                    type: "folder",
                    parent: null
                },
                {
                    id: 7,
                    name: "Applications",
                    type: "folder",
                    parent: null
                }
            ],
            cwd: null,
            history: [],
            bookmarks: [],
            calcHistory: [],
            searchEngine: "LUMA Browser",
            notifications: [],
            notificationsEnabled: true,
            soundVolume: 0.7,
            mod1Animation: "loading",
            coolerLoading: false,
            cursorSoundsEnabled: false,
            cursorTheme: "default",
            soundPack: "bubble"
        };
        // Restore Store-installed/user apps into the live app registry.
        state.soundVolume = typeof state.soundVolume === "number" ? Math.max(0, Math.min(2, state.soundVolume)) : 0.7;
        state.installedApps = state.installedApps || [];
        state.trash = state.trash || {dock: [], apps: []};
        state.trash.dock = Array.isArray(state.trash.dock) ? state.trash.dock : [];
        state.trash.apps = Array.isArray(state.trash.apps) ? state.trash.apps : [];
        state.trash.appData = Array.isArray(state.trash.appData) ? state.trash.appData : [];
        state.coolerLoading = !!state.coolerLoading;
        state.cursorSoundsEnabled = !!state.cursorSoundsEnabled;
        state.homeHidden = Array.isArray(state.homeHidden) ? state.homeHidden : [];
        state.notificationsEnabled = state.notificationsEnabled !== false;
        state.cursorTheme = state.cursorTheme || "default";
        state.soundPack = state.soundPack || "bubble";
        applyCursorTheme();
        state.installedApps.forEach(app => {
            if (app && app.id) apps[app.id] = {
                name: app.name || "Untitled App", icon: app.icon || "🎮",
                w: app.w || 760, h: app.h || 560, html: app.html || "",
                renderer: app.renderer || null, image: app.image || "", storeApp: true
            };
        });
        state.appCustom = state.appCustom || {};
        Object.entries(state.appCustom).forEach(([id, custom]) => {
            if (apps[id] && custom) { if (custom.name) apps[id].name=custom.name; if (custom.icon) apps[id].icon=custom.icon; if (custom.image) apps[id].image=custom.image; }
        });

        let z = 100,
            windows = {},
            browserTabs = [],
            activeTab = 0,
            currentNote = 1,
            paintHistory = [],
            paintStep = -1,
            currentFolder = null;

        function save() {
            try { localStorage.setItem("luma_state", JSON.stringify(state)); return true; }
            catch (e) { console.warn("LUMA state save failed", e); return false; }
        }

        // Clean, short UI sounds. Hover sounds are intentionally disabled because
        // rapid pointer movement can stack audio nodes and sound like static.
        let lumaAudio = null;
        let lastBeepAt = 0;
        function beep(kind="click") {
            try {
                const AC = window.AudioContext || window.webkitAudioContext;
                if (!AC) return;
                const nowMs = performance.now();
                if (nowMs - lastBeepAt < 35) return;
                lastBeepAt = nowMs;
                if (!lumaAudio) lumaAudio = new AC();
                if (lumaAudio.state === 'suspended') lumaAudio.resume();
                const packs = {
                    bubble:{click:{freq:620,dur:.055,gain:.030,type:'sine'},open:{freq:420,dur:.09,gain:.040,type:'sine'},close:{freq:300,dur:.07,gain:.030,type:'sine'},scroll:{freq:700,dur:.025,gain:.018,type:'sine'},blocked:{freq:170,dur:.07,gain:.025,type:'triangle'}},
                    soft:{click:{freq:440,dur:.05,gain:.026,type:'sine'},open:{freq:330,dur:.09,gain:.032,type:'sine'},close:{freq:220,dur:.07,gain:.026,type:'sine'},scroll:{freq:520,dur:.022,gain:.014,type:'sine'},blocked:{freq:150,dur:.06,gain:.022,type:'triangle'}},
                    digital:{click:{freq:760,dur:.035,gain:.028,type:'square'},open:{freq:520,dur:.055,gain:.035,type:'square'},close:{freq:300,dur:.045,gain:.028,type:'square'},scroll:{freq:880,dur:.018,gain:.012,type:'square'},blocked:{freq:180,dur:.05,gain:.020,type:'square'}}
                };
                const presets = packs[state.soundPack] || packs.bubble;
                const set = presets[kind] || presets.click;
                const t = lumaAudio.currentTime;
                const osc = lumaAudio.createOscillator();
                const gain = lumaAudio.createGain();
                osc.type = set.type;
                osc.frequency.setValueAtTime(set.freq, t);
                osc.frequency.exponentialRampToValueAtTime(Math.max(80,set.freq*.82), t+set.dur);
                const volume = Math.max(0, Math.min(2, Number(state.soundVolume ?? 0.7)));
                if (volume <= 0) return;
                const finalGain = set.gain * volume;
                gain.gain.setValueAtTime(0, t);
                gain.gain.linearRampToValueAtTime(finalGain, t+.006);
                gain.gain.exponentialRampToValueAtTime(.0001, t+set.dur);
                osc.connect(gain); gain.connect(lumaAudio.destination);
                osc.start(t); osc.stop(t+set.dur+.01);
            } catch (_) {}
        }
        document.addEventListener('click', e => {
            if (e.target.closest('button,.traffic i,.app-tile,.tab,.newtab,.dock-app,.top-item')) beep('click');
        });
        let lastScrollFx = 0;
        document.addEventListener('wheel', e => {
            if (!state.cursorSoundsEnabled) return;
            const now = performance.now();
            if (now-lastScrollFx < 95) return;
            lastScrollFx = now;
            beep('scroll');
        }, {passive:true});
        function applyCursorTheme(){
            document.body.classList.remove('cursor-macos','cursor-circle','cursor-crosshair','cursor-pixel');
            if(state.cursorSoundsEnabled && state.cursorTheme && state.cursorTheme !== 'default') document.body.classList.add('cursor-'+state.cursorTheme);
        }

        // Wallpaper storage: keep large/animated wallpapers out of localStorage.
        const WALLPAPER_DB = "luma_wallpapers";
        function wallpaperDB(){
            return new Promise((resolve,reject)=>{
                const req=indexedDB.open(WALLPAPER_DB,1);
                req.onupgradeneeded=()=>{ if(!req.result.objectStoreNames.contains("wallpapers")) req.result.createObjectStore("wallpapers"); };
                req.onsuccess=()=>resolve(req.result);
                req.onerror=()=>reject(req.error);
            });
        }
        async function saveWallpaperBlob(data){
            try{ const db=await wallpaperDB(); await new Promise((res,rej)=>{const tx=db.transaction("wallpapers","readwrite");tx.objectStore("wallpapers").put(data,"current");tx.oncomplete=res;tx.onerror=()=>rej(tx.error)}); db.close(); return true; }catch(e){ return false; }
        }
        async function loadWallpaperBlob(){
            try{ const db=await wallpaperDB(); const value=await new Promise((res,rej)=>{const tx=db.transaction("wallpapers","readonly");const r=tx.objectStore("wallpapers").get("current");r.onsuccess=()=>res(r.result||"");r.onerror=()=>rej(r.error)}); db.close(); return value; }catch(e){ return ""; }
        }
        async function clearWallpaperBlob(){
            try{ const db=await wallpaperDB(); await new Promise((res,rej)=>{const tx=db.transaction("wallpapers","readwrite");tx.objectStore("wallpapers").delete("current");tx.oncomplete=res;tx.onerror=()=>rej(tx.error)}); db.close(); }catch(e){}
        }

        // Widget images use IndexedDB instead of localStorage so image files do not
        // hit the browser's small localStorage quota.
        const WIDGET_DB = "luma_widget_images";
        function widgetDB(){
            return new Promise((resolve,reject)=>{
                const req=indexedDB.open(WIDGET_DB,1);
                req.onupgradeneeded=()=>{ if(!req.result.objectStoreNames.contains("images")) req.result.createObjectStore("images"); };
                req.onsuccess=()=>resolve(req.result);
                req.onerror=()=>reject(req.error);
            });
        }
        async function saveWidgetImage(id,file){
            try{ const db=await widgetDB(); await new Promise((res,rej)=>{const tx=db.transaction("images","readwrite");tx.objectStore("images").put(file,id);tx.oncomplete=res;tx.onerror=()=>rej(tx.error)}); db.close(); return true; }catch(e){ return false; }
        }
        async function loadWidgetImage(id){
            try{ const db=await widgetDB(); const value=await new Promise((res,rej)=>{const tx=db.transaction("images","readonly");const r=tx.objectStore("images").get(id);r.onsuccess=()=>res(r.result||null);r.onerror=()=>rej(r.error)}); db.close(); return value; }catch(e){ return null; }
        }
        async function deleteWidgetImage(id){
            try{ const db=await widgetDB(); await new Promise((res,rej)=>{const tx=db.transaction("images","readwrite");tx.objectStore("images").delete(id);tx.oncomplete=res;tx.onerror=()=>rej(tx.error)}); db.close(); }catch(e){}
        }

        async function applyTheme() {
            document.body.classList.toggle("light", state.theme === "light");
            document.body.classList.toggle("retro-aero", !!state.retroAero);
            document.documentElement.style.setProperty("--accent", state.accent);
            const d=$("desktop"), wp=state.wallpaper||"";
            d.classList.remove("wallpaper-animated","wallpaper-stars","wallpaper-grid","wallpaper-pulse","home-clean","home-blur","home-minimal","home-large-icons");
            if(state.wallpaperMode==="animated") d.classList.add("wallpaper-animated");
            if(state.wallpaperMode==="stars") d.classList.add("wallpaper-stars");
            if(state.wallpaperMode==="grid") d.classList.add("wallpaper-grid");
            if(state.wallpaperMode==="pulse") d.classList.add("wallpaper-pulse");
            if(state.homeStyle) d.classList.add(state.homeStyle);

            let media=$("wallpaperMedia");
            if(!media){
                media=document.createElement("div"); media.id="wallpaperMedia"; media.setAttribute("aria-hidden","true"); d.prepend(media);
            }
            media.innerHTML="";
            d.style.backgroundImage="";

            let source=wp;
            if(state.wallpaperMode==="idb" || !source){
                const stored=await loadWallpaperBlob();
                if(stored) source=stored;
            }
            if(source && !source.startsWith("linear-gradient")){
                const img=document.createElement("img");
                img.src=source; img.alt=""; img.draggable=false;
                img.onload=()=>{ img.style.opacity="1"; };
                img.onerror=()=>{ media.innerHTML=""; d.style.backgroundImage="linear-gradient(135deg,#0b0b0d,#111216,#050506)"; notify("Wallpaper Engine","Wallpaper could not be loaded"); };
                img.style.width="100%"; img.style.height="100%"; img.style.objectFit=state.wallpaperFit||"cover"; img.style.objectPosition="center"; img.style.opacity="0"; img.style.transition="opacity .2s ease";
                media.appendChild(img);
            } else {
                d.style.backgroundImage=source||""; d.style.backgroundSize=state.wallpaperFit||"cover"; d.style.backgroundPosition="center";
            }
            renderHomeModule(); renderDesktopIcons();
            try{ save(); }catch(e){}
        }

        function notify(title,msg){
            if(state.notificationsEnabled===false)return;
            const item={title,msg,time:new Date().toLocaleTimeString()};
            state.notifications.unshift(item); state.notifications=state.notifications.slice(0,30); save(); renderNotifications();
            const host=$("notificationToast"); if(host){const pop=document.createElement("div");pop.className="notification-pop";pop.innerHTML=`<b>${esc(title)}</b><span>${esc(msg)}</span><small>${esc(item.time)}</small>`;host.prepend(pop);setTimeout(()=>{pop.classList.add("out");setTimeout(()=>pop.remove(),260)},3600);while(host.children.length>3)host.lastElementChild.remove();}
        }

        function renderNotifications() {
            $("notifications").innerHTML = state.notifications.length ? state.notifications.map(n => `<div class="notice"><b>${esc(n.title)}</b><br><span>${esc(n.msg)}</span><br><small>${n.time}</small></div>`).join("") : "<p style='color:var(--muted)'>No notifications</p>"
        }

        function clearNotifications() {
            state.notifications = [];
            save();
            renderNotifications()
        }

        function esc(s) {
            return String(s ?? "").replace(/[&<>"']/g, c => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;"
            } [c]))
        }

        function tick() {
            let d = new Date();
            let time = d.toLocaleTimeString([], {
                hour: "numeric",
                minute: "2-digit",
                second: "2-digit"
            });
            let date = d.toLocaleDateString([], {
                weekday: "long",
                month: "long",
                day: "numeric"
            });
            $("clock").textContent = time;
            if ($("homeClockTime")) {
                $("homeClockTime").textContent = time;
                $("homeClockDate").textContent = date
            }
        }
        setInterval(tick, 1000);
