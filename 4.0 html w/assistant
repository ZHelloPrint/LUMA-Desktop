            save(); renderDock(); refreshTrash(); notify('Trash', apps[id]?.name+' was restored to the Dock');
        }
        function deleteDockItem(id){
            state.dockHidden = (state.dockHidden||[]).filter(x=>x!==id);
            state.trash.dock = (state.trash.dock||[]).filter(x=>x!==id);
            save(); renderDock(); refreshTrash(); notify('Trash','Dock item permanently removed');
