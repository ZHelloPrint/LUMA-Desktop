        }

        function showPower(mode) {
            closeModal();
            if (mode === "restart") {
                location.reload();
                return;
            }
            if (mode === "shutdown") {
                $("desktop").style.display = "none";
                modal("LUMA powered off", `<div style="text-align:center;padding:20px"><div style="font-size:42px;font-weight:700">LU</div><p style="color:var(--muted)">This simulated shutdown does not turn off your computer.</p><button class="toolbtn" onclick="closeModal();$("desktop").style.display="block"">Boot LUMA</button></div>`, () => {});
                return;
            }
            modal("LUMA sleeping", `<div style="text-align:center;padding:20px"><div style="font-size:42px;font-weight:700">Z</div><p style="color:var(--muted)">This is a simulated sleep state.</p><button class="toolbtn" onclick="closeModal()">Wake LUMA</button></div>`, () => {});
        }

        // LUMA 3.34 migration: use the crisp HTML Glass Workspace by default for existing installations that have no custom Home Screen module.
