        // Movable home-screen grid for built-in and future desktop icons.
        function openWidgetPicker(){
  const items=[
    ['clock','🕐 Clock','Large live time and date'],
    ['battery','🔋 Battery','Battery level and charging status'],
    ['notes','📝 Quick Notes','A little scratchpad saved in LUMA'],
    ['system','💻 System','LUMA version and installed app count'],
