        function calcPress(x) {
            if (x === "=") {
                try {
                    let e = calcExpr.replace(/×/g, "*").replace(/÷/g, "/").replace(/−/g, "-").replace(/\^/g, "**").replace(/%/g, "/100");
                    let v = Function('"use strict";return (' + e + ')')();
                    if (!Number.isFinite(v)) throw Error();
                    state.calcHistory.unshift(calcExpr + " = " + v);
                    state.calcHistory = state.calcHistory.slice(0, 30);
                    save();
                    calcExpr = String(v)
                } catch {
                    calcExpr = "Error"
                }
            } else if (x === "⌫") calcExpr = calcExpr.slice(0, -1);
            else if (x === "C") calcExpr = "";
            else if (x === "√") calcExpr += "Math.sqrt(";
            else if (x === "±") calcExpr = calcExpr.startsWith("-") ? calcExpr.slice(1) : "-" + calcExpr;
            else if (x === "H") modal("Calculation History", state.calcHistory.map(esc).join("<br>") || "No history");
            else if (x === "MC") calcMem = 0;
            else if (x === "MR") calcExpr += calcMem;
            else if (x === "M+") calcMem += Number(calcExpr) || 0;
            else if (x === "M-") calcMem -= Number(calcExpr) || 0;
            else calcExpr += x;
            updateCalc()
        }

        function updateCalc() {
            let d = $("calcDisp");
            if (d) d.textContent = calcExpr || "0";
