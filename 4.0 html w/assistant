<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>LUMA 3.36 — Added LUMA AI with a ChatGPT handoff and a simulated virtual machine.
  - 3.34 — Web Desktop</title>
    <style>
        * {
            box-sizing: border-box
        }

        html,
        body {
            margin: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif
        }

        :root {
            --accent: #4da3ff;
            --glass: rgba(28, 30, 36, .78);
            --glass2: rgba(245, 247, 250, .78);
            --text: #fff;
            --muted: #b9bec8
        }

        body.light {
            --glass: rgba(246, 247, 249, .82);
            --glass2: rgba(28, 30, 36, .78);
            --text: #17181b;
            --muted: #62666e
        }

        button,
        input,
        textarea,
        select {
            font: inherit
        }

        button {
            border: 0;
            cursor: pointer;
            color: inherit
        }

        #boot {
            position: fixed;
            inset: 0;
            background: #000;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            z-index: 9999;
            transition: opacity .7s;
            opacity: 1;
            overflow: hidden
        }

        #boot.apple-boot {
            background: #000;
        }

        .apple-boot-stage, .cooler-loading-stage {
            position: relative;
            width: min(100vw, 360px);
            aspect-ratio: 1 / 1;
        }

        .apple-boot-art {
            width: 260px;
            height: 260px;
            margin: 0 auto;
            display: block;
            object-fit: contain;
            user-select: none;
            -webkit-user-drag: none
        }

        .apple-boot-progress {
            position: absolute;
            left: 50%;
            top: 84%;
            transform: translate(-50%, -50%);
            width: 48%;
            height: 5px;
            border-radius: 999px;
            background: #292929;
            overflow: hidden;
            box-shadow: 0 0 0 1px #555, inset 0 1px 2px #000
        }

        .apple-boot-progress i {
            display: block;
            width: 0;
            height: 100%;
            border-radius: inherit;
            background: #f4f4f4;
            animation: appleBootLoad 2.85s cubic-bezier(.22,.75,.35,1) forwards
        }

        @keyframes appleBootLoad {
            0% { width: 0 }
            18% { width: 20% }
            48% { width: 51% }
            74% { width: 72% }
            100% { width: 100% }
        }

        .cooler-loading-preview {
            position: fixed;
            inset: 0;
            z-index: 20000;
            display: grid;
            place-items: center;
            background: #000;
            opacity: 0;
            pointer-events: none;
            transition: opacity .15s ease
        }
        .cooler-loading-preview.show { opacity: 1; pointer-events: auto }
        .cooler-loading-preview img { width:260px; height:260px; object-fit:contain; display:block; margin:0 auto }
        .cooler-loading-preview .cooler-progress {
            position:absolute; left:50%; top:84%; transform:translate(-50%,-50%);
            width:41.4%; height:5px; border-radius:999px; background:#292929;
            box-shadow:0 0 0 1px #555, inset 0 1px 2px #000; overflow:hidden
        }
        .cooler-loading-preview .cooler-progress i { display:block; height:100%; width:0; background:#f4f4f4; animation:appleBootLoad 2.85s cubic-bezier(.22,.75,.35,1) forwards }

        #boot.ready {
            opacity: 0;
            pointer-events: none
        }

        .boot-logo {
            font-size: 58px;
            font-weight: 700;
            letter-spacing: -5px
        }

        .boot-sub {
            color: #9da3ad;
            margin-top: 10px
        }

        .progress {
            width: 220px;
            height: 4px;
            background: #292c32;
            border-radius: 10px;
            margin-top: 30px;
            overflow: hidden
        }

        .progress i {
            display: block;
            height: 100%;
            width: 0;
            background: #fff;
            animation: load 1.8s forwards
        }

        @keyframes load {
            to {
                width: 100%
            }
        }

        #desktop {
            position: fixed;
            inset: 0;
            background: linear-gradient(135deg, #10233c 0%, #193b63 42%, #080c14 100%);
            background-size: cover;
            color: var(--text);
            overflow: hidden
        }

        #desktop.preparing #topbar,
        #desktop.preparing #dock,
        #desktop.preparing #homeClock,
        #desktop.preparing #homeModule,
        #desktop.preparing #desktopIcons {
            opacity: 0;
            visibility: hidden
        }

        #desktop.preparing #topbar,
        #desktop.preparing #dock,
        #desktop.preparing #homeClock,
        #desktop.preparing #homeModule,
        #desktop.preparing #desktopIcons {
            transition: opacity .35s ease
        }

        .wallpaper-overlay {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 25% 20%, rgba(77, 163, 255, .25), transparent 35%), radial-gradient(circle at 80% 80%, rgba(132, 83, 255, .18), transparent 32%);
            pointer-events: none
        }

        #desktopIcons {
            position: absolute;
            top: 50px;
            left: 15px;
            display: grid;
            gap: 16px;
            grid-template-columns: repeat(1, 76px);
            z-index: 2
        }

        .deskIcon {
            text-align: center;
            font-size: 12px;
            text-shadow: 0 2px 5px #000;
            padding: 5px;
            border-radius: 8px
        }

        .deskIcon:hover {
            background: rgba(255, 255, 255, .12)
        }

        .deskIcon .ico {
            font-size: 34px;
            display: block;
            margin-bottom: 4px
        }

        #topbar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 34px;
            background: rgba(15, 17, 22, .62);
            backdrop-filter: blur(20px);
            display: flex;
            align-items: center;
            padding: 0 12px;
            z-index: 5000;
            font-size: 13px
        }

        .brand {
            font-weight: 700;
            margin-right: 18px
        }

        .top-item {
            padding: 7px 10px;
            border-radius: 7px
        }

        .top-item:hover {
            background: rgba(255, 255, 255, .1)
        }

        .spacer {
            flex: 1
        }

        .tray {
            display: flex;
            gap: 12px;
            align-items: center;
            color: #eef1f5
        }

        .ram-status{font-size:11px;color:#f5f5f7;opacity:.92;min-width:68px;text-align:center;white-space:nowrap;}
        .ram-status.warn{color:#ffd58a;}
        #notificationToast{position:fixed;right:14px;top:42px;width:min(320px,calc(100vw - 28px));z-index:10050;pointer-events:none;display:grid;gap:8px;}
        .notification-pop{padding:10px 12px;border:1px solid rgba(255,255,255,.14);border-radius:13px;background:rgba(28,29,32,.88);backdrop-filter:blur(24px);box-shadow:0 16px 42px rgba(0,0,0,.35);color:#f5f5f7;animation:notificationIn .34s cubic-bezier(.16,1.25,.3,1) both;}
        .notification-pop b{font-size:11px;display:block}.notification-pop span{font-size:10px;color:#c6c8cc;display:block;margin-top:2px}.notification-pop small{font-size:8px;color:#8e9298;display:block;margin-top:5px;}
        @keyframes notificationIn{from{opacity:0;transform:translateX(18px) scale(.96)}to{opacity:1;transform:none}}
        .notification-pop.out{opacity:0;transform:translateX(18px);transition:.25s;}
        .minimal-icon{filter:grayscale(1);font-family:ui-sans-serif,system-ui,sans-serif;font-weight:500;}
        #dock {
            position: absolute;
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            height: 72px;
            padding: 7px 10px;
            display: flex;
            align-items: end;
            gap: 7px;
            background: rgba(24, 27, 33, .55);
            backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, .15);
            border-radius: 20px;
            z-index: 5000;
            box-shadow: 0 12px 40px rgba(0, 0, 0, .3)
        }

        .dock-app {
            width: 55px;
            height: 55px;
            border-radius: 18px;
            background: linear-gradient(145deg, #454b56, #1e2229);
            display: grid;
            place-items: center;
            font-size: 28px;
            transition: transform .28s cubic-bezier(.16, 1.3, .3, 1), filter .2s;
            position: relative
        }

        .dock-app:hover {
            transform: translateY(-9px) scale(1.08)
        }

        .dock-app.active:after {
            content: "";
            position: absolute;
            bottom: -5px;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--accent)
        }

        #startMenu {
            position: absolute;
            left: 12px;
            bottom: 91px;
            width: min(470px, calc(100vw - 24px));
            max-height: min(700px, calc(100vh - 115px));
            background: var(--glass);
            backdrop-filter: blur(28px);
            border: 1px solid rgba(255, 255, 255, .14);
            border-radius: 18px;
            padding: 15px;
            z-index: 6000;
            display: none;
            box-shadow: 0 25px 70px #0008;
            overflow-y: auto;
            overflow-x: hidden
        }

        .start-head {
            display: flex;
            gap: 8px
        }

        .search {
            width: 100%;
            background: rgba(255, 255, 255, .09);
            border: 1px solid rgba(255, 255, 255, .12);
            border-radius: 10px;
            padding: 10px 12px;
            color: inherit;
            outline: none
        }

        .start-title {
            margin: 15px 2px 9px;
            font-size: 13px;
            color: var(--muted)
        }

        .apps-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 6px;
            align-items: stretch
        }

        @media (max-width: 520px) {
            .apps-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        }
        @media (max-width: 380px) {
            .apps-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        }

        .app-tile-wrap {
            position: relative;
            min-width: 0;
            padding: 0;
            overflow: hidden
        }

        .app-launch {
            width: 100%;
            height: 100%;
            min-height: 74px;
            background: transparent;
            color: inherit;
            display: grid;
            place-items: center;
            gap: 3px;
            padding: 7px 5px 6px
        }

        .app-launch b {
            font-size: 25px
        }

        .app-launch span {
            font-size: 11px;
            text-align: center;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            width: 100%
        }

        .home-add-mini {
            position: absolute;
            top: 5px;
            right: 5px;
            width: 23px;
            height: 23px;
            border-radius: 7px;
            background: rgba(255,255,255,.10);
            opacity: .7;
            font-size: 15px;
            z-index: 2
        }

        .home-add-mini:hover {
            opacity: 1;
            background: var(--accent)
        }

        .title-home {
            margin-left: auto;
            margin-right: 8px;
            padding: 4px 9px;
            border-radius: 7px;
            background: rgba(255,255,255,.08);
            color: var(--muted);
            font-size: 11px
        }

        .title-home:hover {
            color: var(--text);
            background: var(--accent)
        }


        .app-tile {
            padding: 10px 4px;
            border-radius: 12px;
            background: transparent
        }

        .app-tile:hover {
            background: rgba(255, 255, 255, .1)
        }

        .app-tile b {
            display: block;
            font-size: 28px;
            margin-bottom: 5px
        }

        .app-tile span {
            font-size: 11px
        }

        .start-footer {
            display: flex;
            justify-content: space-between;
            margin-top: 12px;
            border-top: 1px solid rgba(255, 255, 255, .1);
            padding-top: 10px
        }

        #notify {
            position: absolute;
            right: 12px;
            top: 45px;
            width: 330px;
            background: var(--glass);
            backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, .15);
            border-radius: 16px;
            padding: 14px;
            z-index: 6500;
            display: none
        }

        .notice {
            padding: 10px;
            border-radius: 10px;
            background: rgba(255, 255, 255, .07);
            margin: 7px 0
        }

        .notice small {
            color: var(--muted)
        }

        .window {
            position: absolute;
            min-width: 180px;
            min-height: 120px;
            background: var(--glass);
            backdrop-filter: blur(28px);
            border: 1px solid rgba(255, 255, 255, .16);
            border-radius: 22px;
            box-shadow: 0 25px 80px rgba(0, 0, 0, .42);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            resize: both;
            z-index: 100;
            transform-origin: center;
            animation: windowPop .48s cubic-bezier(.16, 1.35, .35, 1) both
        }

        .window.focus {
            box-shadow: 0 25px 90px rgba(0, 0, 0, .52), 0 0 0 1px rgba(255, 255, 255, .08)
        }

        .window::after {
            content: "";
            position: absolute;
            right: 3px;
            bottom: 3px;
            width: 16px;
            height: 16px;
            pointer-events: none;
            opacity: .45;
            background: linear-gradient(135deg, transparent 45%, rgba(255,255,255,.55) 46%, rgba(255,255,255,.55) 52%, transparent 53%), linear-gradient(135deg, transparent 62%, rgba(255,255,255,.38) 63%, rgba(255,255,255,.38) 69%, transparent 70%);
            border-radius: 0 0 12px 0
        }

        .window.closing {
            animation: windowClose .24s ease both
        }

        .window.minimizing {
            animation: windowMin .3s cubic-bezier(.7, 0, .84, 0) both
        }

        @keyframes windowPop {
            0% {
                opacity: 0;
                transform: translateY(22px) scale(.82);
                filter: blur(7px)
            }

            65% {
                opacity: 1;
                transform: translateY(-3px) scale(1.025);
                filter: blur(0)
            }

            100% {
                opacity: 1;
                transform: translateY(0) scale(1)
            }
        }

        @keyframes windowClose {
            to {
                opacity: 0;
                transform: translateY(18px) scale(.82);
                filter: blur(5px)
            }
        }

        @keyframes windowMin {
            to {
                opacity: 0;
                transform: translateY(80px) scale(.65)
            }
        }

        .titlebar {
            height: 42px;
            display: flex;
            align-items: center;
            padding: 0 12px;
            border-bottom: 1px solid rgba(255, 255, 255, .1);
            flex-shrink: 0;
            user-select: none
        }

        .traffic {
            display: flex;
            gap: 7px
        }

        .traffic i {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: block
        }

        .close {
            background: #ff5f57
        }

        .min {
            background: #febc2e
        }

        .max {
            background: #28c840
        }

        .win-title {
            flex: 1;
            text-align: center;
            font-size: 13px;
            color: var(--muted);
            margin-left: 55px
        }

        .win-content {
            flex: 1;
            min-height: 0;
            overflow: auto
        }

        .app-loader {
            position: absolute;
            inset: 0;
            display: grid;
            place-items: center;
            background: radial-gradient(circle at 50% 45%, rgba(77, 163, 255, .14), transparent 45%), rgba(8, 10, 14, .62);
            backdrop-filter: blur(18px);
            z-index: 50;
            animation: loaderFade .45s ease both
        }

        .loader-core {
            text-align: center
        }

        .loader-orb {
            width: 64px;
            height: 64px;
            margin: auto;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 25%, #fff 0 8%, var(--accent) 28%, #6f63ff 70%, transparent 72%);
            filter: drop-shadow(0 0 20px rgba(77, 163, 255, .55));
            animation: orbBounce 1s ease-in-out infinite
        }

        .loader-dots {
            display: flex;
            justify-content: center;
            gap: 6px;
            margin-top: 15px
        }

        .loader-dots i {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
            animation: dotBounce .8s infinite alternate
        }

        .loader-dots i:nth-child(2) {
            animation-delay: .12s
        }

        .loader-dots i:nth-child(3) {
            animation-delay: .24s
        }

        .loader-text {
            margin-top: 10px;
            color: var(--muted);
            font-size: 12px
        }

        @keyframes orbBounce {

            0%,
            100% {
                transform: scale(.88) translateY(2px)
            }

            50% {
                transform: scale(1.08) translateY(-7px)
            }
        }

        @keyframes dotBounce {
            to {
                transform: translateY(-7px);
                opacity: .35
            }
        }

        @keyframes loaderFade {
            from {
                opacity: 0;
                transform: scale(1.03)
            }

            to {
                opacity: 1;
                transform: scale(1)
            }
        }

        .media-page {
            height: 100%;
            display: flex;
            flex-direction: column;
            gap: 12px;
            padding: 16px;
            background: radial-gradient(circle at 50% 0, rgba(77, 163, 255, .16), transparent 48%)
        }

        .media-frame {
            flex: 1;
            min-height: 250px;
            border: 0;
            border-radius: 18px;
            background: #050608;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .08), 0 15px 50px rgba(0, 0, 0, .3)
        }

        .media-image {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            border-radius: 18px;
            margin: auto;
            display: block
        }

        .media-title {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--muted)
        }

        .media-title b {
            color: var(--text)
        }

        .bubble {
            animation: bubbleIn .42s cubic-bezier(.16, 1.3, .3, 1) both
        }

        @keyframes bubbleIn {
            from {
                opacity: 0;
                transform: translateY(12px) scale(.94)
            }

            to {
                opacity: 1;
                transform: none
            }
        }

        .toolbar {
            display: flex;
            gap: 7px;
            padding: 9px;
            border-bottom: 1px solid rgba(255, 255, 255, .1)
        }

        .toolbtn {
            background: rgba(255, 255, 255, .08);
