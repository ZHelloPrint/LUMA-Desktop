        function refreshTrash(){ if(windows.trash && windows.trash.content && windows.trash.content.dataset.loaded==='1') renderTrash(windows.trash.content); }
        function moveDockToTrash(id){
            if(!apps[id] || ['files','browser','notes','settings','store','wallpaper','extensions','themestudio'].indexOf(id)<0 && !state.installedApps.some(a=>a.id===id)) return;
            state.dockHidden = Array.isArray(state.dockHidden) ? state.dockHidden : [];
            if(!state.dockHidden.includes(id)) state.dockHidden.push(id);
